# ─── Supabase config (public — exposed in the browser bundle) ────────────────
# When BOTH are present, the app syncs state across devices via Supabase Realtime.
# When either is missing, the app falls back to localStorage (single-device mode).
# Get these from: Supabase Dashboard → your project → Settings → API.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Server-only secrets (NEVER prefix with NEXT_PUBLIC_) ────────────────────
# These never reach the browser. They power the /api/auth/* routes and JWT
# issuance, which replaces the old client-side PIN check.

# Supabase JWT secret — Dashboard → Settings → API → "JWT Secret".
# Used to sign the per-role JWTs that our API hands out; Supabase verifies
# the same signature on every request, which is how RLS authorizes writes.
SUPABASE_JWT_SECRET=

# Coordinator / judge PINs — 4-8 digits each.
# Pick anything memorable but NOT the event date. Rotate before event day.
COORD_PIN=
JUDGE_PIN=
