# Supabase config — copy this file to `.env.local` and fill in.
# When BOTH are present, the app syncs state across devices via Supabase Realtime.
# When either is missing, the app falls back to localStorage (single-device mode).
#
# Get these from: Supabase Dashboard → your project → Settings → API.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
